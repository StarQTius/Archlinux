#!/usr/bin/env fish
# Move focused container to workspace relative to focused output.
#   On laptop (eDP-1): move to workspace $argv[1]
#   On external monitor: move to workspace $argv[1] + 10

if test (count $argv) -ne 1
    echo "usage: xmove2workspace <number>" >&2
    exit 1
end

set -l n $argv[1]
set -l focused_output (swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name')

if test "$focused_output" = "eDP-1"
    # laptop screen: use workspace as-is
else
    # external monitor: offset by 10
    set n (math "$n + 10")
end

swaymsg move container to workspace number $n

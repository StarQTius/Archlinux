#!/bin/fish

if ! argparse "f/fresh" -- $argv
  exit "$status"
end

if set --local --query _flag_fresh
  set with_history false
else
  set with_history true
end

docker build \
  --file "$(status dirname)/code.Dockerfile" \
  --tag claude-code \
  (status dirname) \
&& \
docker run -it --rm \
  --env ANTHROPIC_BASE_URL \
  --env ANTHROPIC_AUTH_TOKEN \
  --env ANTHROPIC_API_KEY \
  --env ANTHROPIC_DEFAULT_SONNET_MODEL \
  --volume .:/workspace \
  --volume $HOME/.claude-code-home:/home/claude/ \
  --volume $HOME:$HOME:ro \
  --workdir /workspace \
  claude-code \
  claude --dangerously-skip-permissions \
         ($with_history && echo -- --resume=code)

#!/bin/fish

set --export CLAUDE_CONTEXT "
  You are in a container. Assume mountpaths may have changed each time you are
  invoked. You were invoked by `$(status -f) $argv` at $PWD. This script is
  reachable by you. Use this information to deduce where you are.
"

if ! argparse "f/fresh" "s/session=" -- $argv
  exit "$status"
end

if set --local --query _flag_fresh
  set with_history false
else
  set with_history true
end

if set --local --query _flag_session
  set session "$_flag_session"
else
  set session "code"
end

docker build \
  --file "$(status dirname)/code.Dockerfile" \
  --tag claude-code \
  (status dirname) \
&& \
docker run -it --rm \
  --env ANTHROPIC_BASE_URL \
  --env ANTHROPIC_AUTH_TOKEN \
  --env ANTHROPIC_API_KEY \
  --env ANTHROPIC_DEFAULT_SONNET_MODEL \
  --env CLAUDE_CONTEXT \
  --volume .:/workspace \
  --volume $HOME/.claude-code-home:/home/claude/ \
  --volume $HOME:$HOME:ro \
  --workdir /workspace \
  claude-code \
  claude --dangerously-skip-permissions \
    ($with_history && echo --resume="$session") \
    (! $with_history && echo --fork-session)

set $ui_dir $HOME/bin/ui

font pango:Monaspace Krypton 10
set $font_color #ffffff
set $unselected_font_color #ffffff77
set $background_color #0a0c109f
set $selected_background_color #777777ff
set $selected_border_color #ffffff55
set $transparent_color #00000000

set $mod Mod4

set $menu swaymsg exec -- alacritty --title=__menu --command $ui_dir/menu.fish
for_window [title=__menu] \
  floating enable, \
  resize set width 20 ppt height 100 ppt, \
  move position 0 px 20 px, \
  sticky enable, \
  shortcuts_inhibitor enable

exec_always swayidle -w before-sleep "physlock -dms"

bindsym $mod+Return exec kitty
bindsym $mod+d exec $menu
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exit
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
bindsym $mod+Tab focus output eDP-1
bindsym $mod+KP_Add focus output DP-1
bindsym $mod+Shift+Tab move container to output eDP-1
bindsym $mod+Shift+KP_Add move container to output DP-1
bindsym $mod+1 exec ~/utils/bin/xworkspace 1
bindsym $mod+2 exec ~/utils/bin/xworkspace 2
bindsym $mod+3 exec ~/utils/bin/xworkspace 3
bindsym $mod+4 exec ~/utils/bin/xworkspace 4
bindsym $mod+5 exec ~/utils/bin/xworkspace 5
bindsym $mod+6 exec ~/utils/bin/xworkspace 6
bindsym $mod+7 exec ~/utils/bin/xworkspace 7
bindsym $mod+8 exec ~/utils/bin/xworkspace 8
bindsym $mod+9 exec ~/utils/bin/xworkspace 9
bindsym $mod+0 exec ~/utils/bin/xworkspace 10
bindsym $mod+Shift+1 exec ~/utils/bin/xmove2workspace 1
bindsym $mod+Shift+2 exec ~/utils/bin/xmove2workspace 2
bindsym $mod+Shift+3 exec ~/utils/bin/xmove2workspace 3
bindsym $mod+Shift+4 exec ~/utils/bin/xmove2workspace 4
bindsym $mod+Shift+5 exec ~/utils/bin/xmove2workspace 5
bindsym $mod+Shift+6 exec ~/utils/bin/xmove2workspace 6
bindsym $mod+Shift+7 exec ~/utils/bin/xmove2workspace 7
bindsym $mod+Shift+8 exec ~/utils/bin/xmove2workspace 8
bindsym $mod+Shift+9 exec ~/utils/bin/xmove2workspace 9
bindsym $mod+Shift+0 exec ~/utils/bin/xmove2workspace 10
bindsym $mod+ampersand exec ~/utils/bin/xworkspace 1
bindsym $mod+eacute exec ~/utils/bin/xworkspace 2
bindsym $mod+quotedbl exec ~/utils/bin/xworkspace 3
bindsym $mod+apostrophe exec ~/utils/bin/xworkspace 4
bindsym $mod+parenleft exec ~/utils/bin/xworkspace 5
bindsym $mod+minus exec ~/utils/bin/xworkspace 6
bindsym $mod+egrave exec ~/utils/bin/xworkspace 7
bindsym $mod+underscore exec ~/utils/bin/xworkspace 8
bindsym $mod+ccedilla exec ~/utils/bin/xworkspace 9
bindsym $mod+agrave exec ~/utils/bin/xworkspace 10
bindsym $mod+Shift+ampersand exec ~/utils/bin/xmove2workspace 1
bindsym $mod+Shift+eacute exec ~/utils/bin/xmove2workspace 2
bindsym $mod+Shift+quotedbl exec ~/utils/bin/xmove2workspace 3
bindsym $mod+Shift+apostrophe exec ~/utils/bin/xmove2workspace 4
bindsym $mod+Shift+parenleft exec ~/utils/bin/xmove2workspace 5
bindsym $mod+Shift+minus exec ~/utils/bin/xmove2workspace 6
bindsym $mod+Shift+egrave exec ~/utils/bin/xmove2workspace 7
bindsym $mod+Shift+underscore exec ~/utils/bin/xmove2workspace 8
bindsym $mod+Shift+ccedilla exec ~/utils/bin/xmove2workspace 9
bindsym $mod+Shift+agrave exec ~/utils/bin/xmove2workspace 10
bindsym $mod+f fullscreen
bindsym XF86AudioRaiseVolume exec $ui_dir/control/audio.fish volume increase 5
bindsym XF86AudioLowerVolume exec $ui_dir/control/audio.fish volume decrease 5
bindsym XF86AudioMute exec $ui_dir/control/audio.fish toggle_mute
bindsym XF86AudioPrev exec $ui_dir/control/audio.fish previous
bindsym XF86AudioNext exec $ui_dir/control/audio.fish next
bindsym XF86AudioPlay exec $ui_dir/control/audio.fish toggle_play
bindsym XF86MonBrightnessUp exec $ui_dir/control/brightness.fish increase 5
bindsym XF86MonBrightnessDown exec $ui_dir/control/brightness.fish decrease 5

bar {
    position top
    status_command $ui_dir/status_bar/status_bar.fish 2>status_bar.stderr
    colors {
        statusline $font_color
        background $background_color
        inactive_workspace $background_color $background_color $unselected_font_color
        focused_workspace $background_color $background_color $font_color
    }
}

client.focused $transparent_color $selected_border_color $font_color $selected_border_color
client.focused_inactive $transparent_color $background_color $font_color $background_color
client.unfocused $transparent_color $background_color $unselected_font_color $background_color

default_border pixel 1
default_floating_border none

mouse_warping output

exec --no-startup-id systemctl --user import-environment
exec awww-daemon
exec_always mako
exec_always autotiling

workspace 1 output eDP-1
workspace 11 output DP-1

output eDP-1 position 0 0
output DP-1 position 8000 0

exec --no-startup-id swaymsg focus output DP-1

input "4152:5660:SteelSeries_SteelSeries_Apex_5" {
    xkb_layout fr
}
